# --- Core API endpoints ---
VITE_API_BASE_URL=https://api.your-domain.com
VITE_AUTH_SERVICE_URL=https://auth.your-domain.com
VITE_AUDIT_LOG_ENDPOINT=https://api.your-domain.com/audit-log

# --- Mail & OTP delivery ---
VITE_MAIL_PROVIDER_KEY=replace-with-provider-key
VITE_MAIL_FROM_ADDRESS=no-reply@your-domain.com
VITE_OTP_EXPIRY_MINUTES=5
VITE_OTP_LENGTH=6

# --- Payment processing (client-facing keys only) ---
VITE_PAYMENT_PUBLIC_KEY=pk_live_replace_me
VITE_PAYMENT_WEBHOOK_SECRET=whsec_replace_me

# --- Analytics & monitoring ---
VITE_ANALYTICS_WRITE_KEY=segment-write-key
VITE_PROCTORING_SOCKET_URL=wss://proctor.your-domain.com
VITE_INCIDENT_WEBHOOK_URL=https://api.your-domain.com/proctoring/incidents

# --- Integrity automation ---
VITE_HEARTBEAT_ENDPOINT=https://api.your-domain.com/proctoring/heartbeat
VITE_HEARTBEAT_INTERVAL_SECONDS=30
VITE_SCREENSHOT_WEBHOOK=https://api.your-domain.com/proctoring/screenshot
VITE_DEVICE_FINGERPRINT_SALT=psycheprep-demo
VITE_DEVTOOLS_SENSITIVITY=140
VITE_REQUIRE_CAMERA=true
VITE_GEOFENCE_LAT=28.6139
VITE_GEOFENCE_LNG=77.2090
VITE_GEOFENCE_RADIUS_KM=25

# --- Network & security ---
VITE_IP_LOOKUP_ENDPOINT=https://api64.ipify.org?format=json
VITE_SESSION_TTL_MINUTES=180
VITE_IP_LOCK_MINUTES=180
